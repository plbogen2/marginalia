# Stage 1: Build the frontend static assets
FROM node:22-alpine AS builder
ENV NODE_OPTIONS="--max-old-space-size=512"
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN [ -f package-lock.json ] && sed -i 's|https://us-npm.pkg.dev/artifact-foundry-prod/ah-3p-staging-npm/|https://registry.npmjs.org/|g' package-lock.json || true
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Stage 2: Serve static assets via Caddy with SPA routing
FROM caddy:2-alpine
WORKDIR /srv
COPY --from=builder /app/frontend/dist /srv
COPY frontend/Caddyfile /etc/caddy/Caddyfile
EXPOSE 80
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
