64-181-248-211.nip.io {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            disable_http_challenge
        }
    }

    # Compression for static bundles, text, and JSON API responses
    encode zstd gzip

    # Production HTTP Security Headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    # Restrict max request body size to 25MB to prevent memory exhaustion attacks
    request_body {
        max_size 25MB
    }

    # Route API and Server-Sent Events / WebSockets to the Express backend container
    handle /api/* {
        reverse_proxy marginalia_backend_blue:3000 {
            lb_try_duration 10s
            lb_try_interval 250ms
        }
    }

    # All other requests (HTML, JS, CSS, static assets) route to the Frontend container
    handle {
        reverse_proxy marginalia_frontend_blue:80 {
            lb_try_duration 10s
            lb_try_interval 250ms
        }
    }
}
